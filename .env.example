# Origin of the REST API, without a path: the BFF adds `/api/v1` itself.
# The mock API (`npm run mock`) listens on http://localhost:4010.
API_URL=http://localhost:4010

# Mark the session cookie `Secure`. Defaults to true in production; browsers drop a Secure cookie
# on plain HTTP, so set it to false when serving over http (local compose, e2e).
# COOKIE_SECURE=false
